; The Sock Gang - Godot version. Everything is built from code at runtime.
config_version=5

[application]

config/name="The Sock Gang"
config/description="The Sock Gang — кооперативная игра про гномов-проказников"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.04, 0.07, 1)
boot_splash/show_image=false
run/low_processor_mode=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="SockGang"

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.25

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=24.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6

[rendering]

rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=2048
textures/default_filters/anisotropic_filtering_level=2
