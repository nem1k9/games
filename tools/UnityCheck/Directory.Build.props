<Project>
  <PropertyGroup>
    <!-- several projects live in one folder: give each its own obj/ so NuGet assets files don't clash -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1701;CS1702;CS0649;CS0414</NoWarn>
    <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
    <UnityDefines>UNITY_2021_3_OR_NEWER;UNITY_STANDALONE;ENABLE_LEGACY_INPUT_MANAGER;UNITY_COMPILE_CHECK</UnityDefines>
  </PropertyGroup>
</Project>
