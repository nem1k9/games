<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Assets/Scripts/Core exactly like Unity does (netstandard2.1, C# 9, no engine refs). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Gnomes.Core</AssemblyName>
    <DefineConstants>$(UnityDefines)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
